# Боевой веб-сервер: сертификат, раздача интерфейса, проксирование к API.
# На сервере файл лежит в /etc/caddy/Caddyfile; здесь — версия под контролем,
# чтобы конфигурация не существовала в единственном экземпляре на машине.
#
# Локальный запуск через Docker обслуживает nginx (docker/nginx.conf) — там те же
# правила для окружения без сертификата.

svoislova-ai.ru {
	encode zstd gzip

	# Потолок чуть выше лимита приложения (20 Ми): слишком большой файл должен
	# отвергать сам сервис понятной ошибкой 413 с JSON, а не веб-сервер — обрывом
	# соединения, по которому клиенту непонятно, что произошло.
	request_body {
		max_size 25MB
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	# Без отдельного правила проверка живости уходила бы в подстановку index.html
	# и всегда отвечала бы страницей интерфейса — то есть «здоров» при мёртвом API.
	handle /health {
		reverse_proxy 127.0.0.1:3000
	}

	# Сгенерированное медиа и загруженные референсы лежат в каталогах данных
	# приложения, а не в сборке интерфейса, и раздаёт их оно же — вместе с
	# защитными заголовками для содержимого, пришедшего от клиента.
	handle /media/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle /uploads/* {
		reverse_proxy 127.0.0.1:3000
	}

	# Всё остальное — одностраничный интерфейс. Адреса вроде /onboarding/<токен>
	# существуют только в браузере, файла на диске под ними нет, поэтому
	# неизвестный путь отдаётся как index.html, а не как 404.
	handle {
		root * /opt/ai-smm-assistant/frontend/dist
		try_files {path} /index.html
		file_server
	}
}

# Имя с www заявлено в DNS наравне с основным, поэтому обслуживать его
# обязательно: иначе пришедший на www получит ошибку сертификата, а не сайт.
www.svoislova-ai.ru {
	redir https://svoislova-ai.ru{uri} permanent
}
