# Скопируйте в .env и заполните. Файл .env в .gitignore и в репозиторий не попадает.
# Без ключей сервис запускается, но соответствующие возможности отключаются —
# см. комментарии ниже.

# --- Обязательное ---

# OpenRouter: все текстовые агенты, генерация картинок и видео.
# Слаг модели указывается с префиксом провайдера (anthropic/claude-sonnet-5).
OPENROUTER_API_KEY=

# --- Уведомления оператору (необязательно) ---

# Телеграм-бот, через который оператор получает заявки с лендинга и одобряет их
# кнопкой. Без этих двух переменных бот не запускается, заявки подтверждаются
# только через CLI (npm run admin:approve).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Парсер ВКонтакте (необязательно) ---

# Сервисный ключ приложения ВК. Без него анализируются только Telegram-площадки.
VK_SERVICE_TOKEN=

# --- Почта клиенту (необязательно) ---

# HTTP API Unisender Go, не SMTP. Без ключа и адреса отправителя письма не
# отправляются: оператор получает ссылку в Telegram и пересылает вручную.
UNISENDER_API_KEY=
# Адрес на домене с подтверждённой отправкой.
MAIL_FROM=noreply@example.com
# Живой ящик, куда придут ответы клиентов: у домена отправителя нет MX-записей,
# отвечать на MAIL_FROM физически некуда.
MAIL_REPLY_TO=
MAIL_FROM_NAME=Своими словами

# --- Сеть ---

# Публичный адрес, который видит пользователь: на него ведут ссылки в письмах.
# В разработке — порт фронтенда, в проде — домен, где фронтенд и API живут за
# одним веб-сервером.
BASE_URL=http://localhost:5173

# Форвард-прокси для вызовов, которым нужен выход через другую страну
# (модели и Telegram). Пусто — все запросы идут напрямую; так работает
# машина разработчика. Строка содержит пароль, это тоже секрет.
# Формат: http://логин:пароль@адрес:порт
OUTBOUND_PROXY_URL=

# Адрес, на котором приложение слушает. По умолчанию 0.0.0.0 — так к нему
# достаёт nginx из соседнего контейнера при локальном запуске через Docker.
# Если приложение и веб-сервер стоят на одной машине, задавайте 127.0.0.1:
# иначе порт API открыт напрямую в интернет, в обход TLS и правил веб-сервера.
# HOST=127.0.0.1

# --- Пути и порты (необязательно, есть значения по умолчанию) ---

# PORT=3000
# DB_PATH=./data/app.sqlite
# UPLOAD_DIR=./uploads
# NODE_ENV=production
